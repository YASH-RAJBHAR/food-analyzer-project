# ==================================================
# FOOD ANALYZER — ENVIRONMENT VARIABLE TEMPLATE
# ==================================================

# --------------------------------------------------
# 1. FRONTEND (React Static Site / Web Service)
# --------------------------------------------------
# URL of the deployed Spring Boot Backend Service on Render
REACT_APP_BACKEND_URL=https://food-analyzer-backend.onrender.com

# --------------------------------------------------
# 2. JAVA SPRING BOOT BACKEND (Render Web Service)
# --------------------------------------------------
# Port provided dynamically by Render
PORT=8080

# URL of the deployed Python AI Service on Render
FLASK_AI_URL=https://food-analyzer-ai-service.onrender.com/predict

# Allowed CORS Origins (Frontend URL or comma-separated list / * for open access)
CORS_ALLOWED_ORIGINS=https://food-analyzer-frontend.onrender.com

# Database Connection (H2 in-memory DB by default, or external MySQL/PostgreSQL)
# DATABASE_URL=jdbc:mysql://your-db-host:3306/fooddb?useSSL=false
# MYSQL_USER=your_db_user
# MYSQL_PASSWORD=your_db_password

# External API Keys (Optional)
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# --------------------------------------------------
# 3. PYTHON AI SERVICE (Render Web Service)
# --------------------------------------------------
# Port provided dynamically by Render
# PORT=5001

# Optional Gemini Vision & AI Coach Agent API Key
GEMINI_API_KEY=your_gemini_api_key_here
